{
  "name": "server-tools",
  "version": "1.0.0",
  "description": "Server Tools: rule-based MySQL batch updates with one-by-one human approval in a web UI, plus SSH tooling",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "vendor:toast": "esbuild node_modules/gooey-toast/dist/index.js --bundle --format=iife --global-name=gooeyToast --minify --outfile=public/vendor/gooey-toast/gooey-toast.iife.js && node -e \"require('fs').copyFileSync('node_modules/gooey-toast/dist/styles.css','public/vendor/gooey-toast/styles.css')\"",
    "build": "pkg . --output dist/server-tools.exe"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "assets": [
      "public/**/*",
      "node_modules/intro.js/minified/**",
      "node_modules/tabulator-tables/dist/**",
      "node_modules/codemirror/lib/**",
      "node_modules/codemirror/mode/sql/**",
      "node_modules/codemirror/mode/javascript/**",
      "node_modules/codemirror/addon/hint/**",
      "node_modules/codemirror/addon/display/**",
      "node_modules/codemirror/theme/material-darker.css"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^5.65.21",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "gooey-toast": "^0.2.2",
    "intro.js": "^8.5.0",
    "mysql2": "^3.11.5",
    "php-serialize": "^4.1.1",
    "ssh2": "^1.16.0",
    "tabulator-tables": "^6.5.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.8.0"
  }
}
