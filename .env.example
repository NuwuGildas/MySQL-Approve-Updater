# NOTE: quote any value containing # (or other special characters) in single
# quotes, e.g. PASSWORD='p#ss!word' — an unquoted # starts a comment and
# silently truncates the value.

# ---- MySQL connection ----
# When SSH tunneling is enabled (SSH_HOST set), DB_HOST/DB_PORT are the address
# of MySQL AS SEEN FROM THE SSH SERVER (usually 127.0.0.1:3306).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=mydatabase

# ---- SSH tunnel (optional — leave SSH_HOST empty to connect directly) ----
# SSH_TUNNEL=false disables the tunnel without removing the settings below.
SSH_TUNNEL=true
SSH_HOST=ssh.example.com
SSH_PORT=22
SSH_USER=deploy
# Auth: set either SSH_PASSWORD, or SSH_PRIVATE_KEY_PATH (+ optional SSH_PASSPHRASE)
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=C:\Users\you\.ssh\id_ed25519
SSH_PASSPHRASE=

# ---- App ----
PORT=3000
# Hard server-side cap on rows fetched per preview (rules cannot exceed this)
MAX_PREVIEW_ROWS=500